# ── Local development ────────────────────────────────────────────────
# The Vite dev server proxies /api and /socket.io to this address, so the app
# talks to the backend on its own origin and needs no CORS.
VITE_API_PROXY_TARGET=http://localhost:8001

VITE_CLERK_PUBLISHABLE_KEY=

# Supabase — fill when you link a project
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Production ───────────────────────────────────────────────────────
# There is no proxy in front of a static host, so point the app straight at the
# API's origin. Leave it blank locally. No trailing slash.
#   VITE_API_ORIGIN=https://api.yourdomain.com
# The same origin must appear in the backend's CORS_ORIGINS, and this app's own
# origin must be in the backend's CUSTOMER_APP_BASE_URL / CLERK_AUTHORIZED_PARTIES.
VITE_API_ORIGIN=

# Origin this app is served from, used for Clerk redirects.
#   VITE_APP_ORIGIN=https://app.yourdomain.com
VITE_APP_ORIGIN=
