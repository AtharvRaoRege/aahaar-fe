# Vite frontend env. Copy to `.env` in this folder.

# Aahaar API is on 8001 because another app already uses 8000.
VITE_API_PROXY_TARGET=http://localhost:8001

# Public origin of this app (used for Clerk redirect allow-list in production).
# Comma-separated if you have more than one, e.g. https://aahaar.app,https://www.aahaar.app
VITE_APP_ORIGIN=

# Clerk publishable key (pk_test_... from the Clerk Dashboard).
# Leave empty to hide Google login. Email/password still works.
VITE_CLERK_PUBLISHABLE_KEY=
